<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ФОНЫ -->
    <Color x:Key="ColorBackground">#14141A</Color>
    <Color x:Key="ColorPanel">#1E1E28</Color>
    <Color x:Key="ColorCard">#282838</Color>
    <Color x:Key="ColorCardHover">#323246</Color>
    <Color x:Key="ColorBorder">#3A3A4A</Color>

    <!-- ТЕКСТ -->
    <Color x:Key="ColorTextPrimary">#E8E8F0</Color>
    <Color x:Key="ColorTextSecondary">#A0A0B0</Color>
    <Color x:Key="ColorTextDisabled">#606070</Color>

    <!-- АКЦЕНТЫ -->
    <Color x:Key="ColorAccent">#3D7EBF</Color>
    <Color x:Key="ColorAccentHover">#4A8FD4</Color>
    <Color x:Key="ColorAccentPressed">#2F6699</Color>

    <Color x:Key="ColorSuccess">#22C55E</Color>
    <Color x:Key="ColorDanger">#B0303A</Color>
    <Color x:Key="ColorDangerHover">#C93B46</Color>
    <Color x:Key="ColorDangerPressed">#8C2029</Color>

    <!-- КИСТИ -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}"/>
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}"/>

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="{StaticResource ColorDangerHover}"/>
    <SolidColorBrush x:Key="BrushDangerPressed" Color="{StaticResource ColorDangerPressed}"/>

    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccent}" Opacity="0.15"/>

    <!-- РАЗМЕРЫ -->
    <sys:Double x:Key="RadiusSmall">4</sys:Double>
    <sys:Double x:Key="RadiusMedium">8</sys:Double>
</ResourceDictionary>