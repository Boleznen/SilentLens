<Window x:Class="SilentLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Silent Lens"
        Height="720" Width="1280"
        MinHeight="500" MinWidth="950"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="{StaticResource BrushBackground}"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLEBAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="◉" FontSize="18"
                                   Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Silent Lens" Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <Button x:Name="BtnFolders"
                                Style="{StaticResource IconButton}"
                                Click="BtnFolders_Click"
                                ToolTip="Быстрый доступ к папкам"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="📂" FontSize="15" VerticalAlignment="Center"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="FoldersMenu">
                                    <MenuItem Header="Открыть папку выбранного файла"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenFileFolder_Click"/>
                                    <MenuItem Header="Открыть папку с оригиналом"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenOriginalFolder_Click"/>

                                    <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                                           Margin="8,4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>

                                    <MenuItem Header="Папка логов"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenLogs_Click"/>
                                    <MenuItem Header="Папка настроек"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenSettingsFolder_Click"/>
                                    <MenuItem Header="Папка данных Silent Lens"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenDataFolder_Click"/>

                                    <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                                           Margin="8,4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>

                                    <MenuItem Header="Файл настроек (settings.json)"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenSettingsFile_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Style="{StaticResource IconButton}"
                                Click="BtnMinimize_Click" ToolTip="Свернуть"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,6 L 10,6"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="1"/>
                        </Button>

                        <Button Style="{StaticResource IconButton}"
                                Click="BtnMaximize_Click" ToolTip="Развернуть"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="1" Fill="Transparent"/>
                        </Button>

                        <Button Style="{StaticResource CloseButton}"
                                Click="BtnClose_Click" ToolTip="Закрыть"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{StaticResource BrushTextPrimary}"
                                  StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MENU + TOOLBAR -->
            <StackPanel Grid.Row="1">
                <Menu>
                    <MenuItem Header="Файл">
                        <MenuItem Header="Добавить файлы..." InputGestureText="Ctrl+O" Click="MenuAddFiles_Click"/>
                        <MenuItem Header="Добавить папку..." Click="MenuAddFolder_Click"/>

                        <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                               Margin="8,4" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                        <MenuItem Header="Экспорт метаданных в TXT..." Click="MenuExportMetaTxt_Click"/>
                        <MenuItem Header="Экспорт метаданных в JSON..." Click="MenuExportMetaJson_Click"/>

                        <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                               Margin="8,4" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                        <MenuItem Header="Экспорт оригиналов в ZIP..." Click="MenuExportOriginalsZip_Click"/>
                        <MenuItem Header="Экспорт отчёта..." Click="MenuExportReport_Click"/>

                        <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                               Margin="8,4" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                        <MenuItem Header="Выход" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Правка">
                        <MenuItem Header="Убрать выбранные" InputGestureText="Delete" Click="MenuRemoveSelected_Click"/>
                        <MenuItem Header="Очистить список" Click="MenuClearList_Click"/>
                    </MenuItem>
                    <MenuItem Header="Сервис">
                        <MenuItem Header="Настройки..." Click="MenuSettings_Click"/>
                        <MenuItem Header="Проверить обновления" Click="MenuCheckUpdates_Click"/>

                        <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                            <MenuItem.Template>
                                <ControlTemplate TargetType="MenuItem">
                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                               Margin="8,4" SnapsToDevicePixels="True"/>
                                </ControlTemplate>
                            </MenuItem.Template>
                        </MenuItem>

                        <MenuItem Header="Открыть папку логов" Click="MenuOpenLogs_Click"/>
                        <MenuItem Header="Открыть папку настроек" Click="MenuOpenSettingsFolder_Click"/>
                        <MenuItem Header="Показать выбранный файл в проводнике" Click="MenuOpenFileFolder_Click"/>
                        <MenuItem Header="Открыть папку с оригиналом" Click="MenuOpenOriginalFolder_Click"/>
                    </MenuItem>
                    <MenuItem Header="Помощь">
                        <MenuItem Header="О программе" Click="MenuAbout_Click"/>
                        <MenuItem Header="Связь с разработчиком" Click="MenuContact_Click"/>
                    </MenuItem>
                </Menu>

                <Border Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить файлы"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,6,0" Click="MenuAddFiles_Click"/>
                        <Button Content="Добавить папку"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,6,0" Click="MenuAddFolder_Click"/>
                        <Button Content="📂  Открыть папку файла"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,6,0" Click="BtnOpenFileFolder_Click"
                                ToolTip="Открыть папку выбранного файла в проводнике"/>

                        <Border Width="1" Margin="8,2" Background="{StaticResource BrushBorder}"/>

                        <Button Content="Стереть GPS"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,6,0" Click="WipeGps_Click"
                                ToolTip="Удалить GPS-координаты выбранного файла"/>
                        <Button Content="Оставить только дату"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,6,0" Click="WipeKeepDate_Click"
                                ToolTip="Удалить всё, кроме даты съёмки"/>
                        <Button Content="Стереть всё"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,6,0" Click="WipeAll_Click"
                                ToolTip="Удалить все метаданные из выбранных файлов"/>

                        <Border Width="1" Margin="8,2" Background="{StaticResource BrushBorder}"/>

                        <Button Content="⚙  Применить ко всем"
                                Style="{StaticResource AccentButton}"
                                Click="BatchApply_Click"
                                ToolTip="Пакетная обработка всех файлов в списке"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CONTENT: 3 columns -->
            <Grid Grid.Row="2" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="350"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="380" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Files -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Файлы" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>

                        <Border Grid.Row="1" Padding="6,6"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ComboBox x:Name="SortCombo"
                                          SelectionChanged="SortCombo_SelectionChanged"
                                          Margin="0,0,0,6">
                                    <ComboBoxItem Content="По имени"/>
                                    <ComboBoxItem Content="По размеру"/>
                                    <ComboBoxItem Content="По дате изменения"/>
                                    <ComboBoxItem Content="По дате съёмки"/>
                                </ComboBox>

                                <TextBox x:Name="SearchBox"
                                         TextChanged="SearchBox_TextChanged"
                                         ToolTip="Поиск по имени файла"/>
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="2" x:Name="FileList"
                                 Margin="4"
                                 SelectionMode="Extended"
                                 SelectionChanged="FileList_SelectionChanged"
                                 MouseDoubleClick="FileList_MouseDoubleClick"
                                 KeyDown="FileList_KeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Стереть метаданные (GPS)"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="WipeGps_Click"/>
                                    <MenuItem Header="Оставить только дату"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="WipeKeepDate_Click"/>
                                    <MenuItem Header="Стереть всё"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="WipeAll_Click"/>

                                    <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                                           Margin="8,4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>

                                    <MenuItem Header="Сравнить «до / после»"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuCompare_Click"/>

                                    <MenuItem Header="Экспорт метаданных (TXT)"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuExportMetaTxt_Click"/>
                                    <MenuItem Header="Экспорт метаданных (JSON)"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuExportMetaJson_Click"/>

                                    <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                                           Margin="8,4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>

                                    <MenuItem Header="Показать в проводнике"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenFileFolder_Click"/>
                                    <MenuItem Header="Открыть папку с оригиналом"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuOpenOriginalFolder_Click"/>

                                    <MenuItem IsEnabled="False" Height="9" Focusable="False" Padding="0">
                                        <MenuItem.Template>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Rectangle Height="1" Fill="{StaticResource BrushBorder}"
                                                           Margin="8,4" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </MenuItem.Template>
                                    </MenuItem>

                                    <MenuItem Header="Копировать путь"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuCopyPath_Click"/>
                                    <MenuItem Header="Убрать из списка"
                                              Style="{StaticResource ContextMenuItemStyle}"
                                              Click="MenuRemoveSelected_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Width="36" Height="36"
                                                Background="{StaticResource BrushCard}"
                                                CornerRadius="4">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FileSizeFormatted}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- MIDDLE: Preview -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Превью" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>

                        <Grid Grid.Row="1" Background="{StaticResource BrushBackground}">
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   Margin="10"/>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       Text="Выберите файл, чтобы увидеть превью"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="20"/>
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- RIGHT: Metadata -->
                <Border Grid.Column="4"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="10,8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Метаданные" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel x:Name="MetadataPanel">
                                <TextBlock Text="Выберите файл из списка, чтобы увидеть метаданные"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- STATUSBAR -->
            <Border Grid.Row="3"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Height="26">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Готово"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusStats" Text=""
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="12,0,16,0"
                               Grid.Column="1"/>
                    <TextBlock Text="v1.0.0"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Grid.Column="2"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>