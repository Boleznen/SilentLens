<Window x:Class="SilentLens.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение метаданных — Silent Lens"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Тайтлбар -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="⇄" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Сравнение «до / после»"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButton}"
                            Click="BtnClose_Click" ToolTip="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource BrushTextPrimary}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Контент: две колонки -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- БЫЛО -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Background="{StaticResource BrushCard}">
                            <TextBlock Text="ДО — оригинал из _Original"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel x:Name="BeforePanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- СТАЛО -->
                <Border Grid.Column="2"
                        Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="10,8"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Background="{StaticResource BrushCard}">
                            <TextBlock Text="ПОСЛЕ — текущий файл"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSuccess}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel x:Name="AfterPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопки -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Экспорт в TXT"
                            Style="{StaticResource BaseButton}"
                            MinWidth="140"
                            Margin="0,0,8,0"
                            Click="BtnExportTxt_Click"/>
                    <Button Content="Экспорт в JSON"
                            Style="{StaticResource BaseButton}"
                            MinWidth="140"
                            Margin="0,0,8,0"
                            Click="BtnExportJson_Click"/>
                    <Button Content="Закрыть"
                            Style="{StaticResource BaseButton}"
                            MinWidth="100"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>