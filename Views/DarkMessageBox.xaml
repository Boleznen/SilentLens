<Window x:Class="SilentLens.Views.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Silent Lens"
        SizeToContent="Height"
        Width="480"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Тайтлбар -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock x:Name="TitleIcon"
                                   Text="◉"
                                   FontSize="16"
                                   Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleText"
                                   Text="Silent Lens"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButton}"
                            Click="BtnClose_Click"
                            ToolTip="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource BrushTextPrimary}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Row="1" Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="IconText"
                           Text="ℹ"
                           FontSize="36"
                           Foreground="{StaticResource BrushAccent}"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"/>

                <TextBlock Grid.Column="1"
                           x:Name="MessageText"
                           Text="Сообщение"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Кнопки -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>