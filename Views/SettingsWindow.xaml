<Window x:Class="SilentLens.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Silent Lens"
        Height="720" Width="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="⚙" FontSize="16"
                                   Foreground="{StaticResource BrushAccent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Настройки"
                                   Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButton}"
                            Click="BtnClose_Click" ToolTip="Закрыть">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource BrushTextPrimary}"
                              StrokeThickness="1"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>

                    <!-- ОРИГИНАЛЫ -->
                    <TextBlock Text="Сохранение оригиналов"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkSaveOriginals"
                              Content="Сохранять оригиналы перед удалением метаданных"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="Папка для оригиналов:"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,6,0,4"/>
                    <TextBox x:Name="TxtOriginalFolder" Text="_Original" Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkAutoClean"
                              Content="Авто-очистка старых оригиналов"
                              Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="20,0,0,16">
                        <TextBlock Text="Удалять старше:"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtBackupDays" Text="30" Width="60"/>
                        <TextBlock Text="дней"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- ПОВЕДЕНИЕ -->
                    <TextBlock Text="Поведение окна"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <CheckBox x:Name="ChkMinimizeToTray"
                              Content="Сворачивать в трей при закрытии"
                              Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkAutoStart"
                              Content="Автозапуск при старте Windows"
                              Margin="0,0,0,16"/>

                    <!-- УВЕДОМЛЕНИЯ -->
                    <TextBlock Text="Уведомления"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <CheckBox x:Name="ChkShowNotifications"
                              Content="Показывать уведомления Windows"
                              Margin="0,0,0,16"/>

                    <!-- ПАКЕТНАЯ ОБРАБОТКА -->
                    <TextBlock Text="Пакетная обработка"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <CheckBox x:Name="ChkSkipBatchConfirm"
                              Content="Не спрашивать подтверждение при батче"
                              Checked="ChkSkipBatchConfirm_Changed"
                              Unchecked="ChkSkipBatchConfirm_Changed"
                              Margin="0,0,0,16"/>

                    <!-- ОБНОВЛЕНИЯ -->
                    <TextBlock Text="Обновления"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <CheckBox x:Name="ChkCheckUpdates"
                              Content="Проверять обновления при запуске"
                              Margin="0,0,0,12"/>

                    <Button Content="Проверить сейчас"
                            Style="{StaticResource BaseButton}"
                            HorizontalAlignment="Left"
                            Click="BtnCheckUpdates_Click"
                            Margin="0,0,0,16"/>

                    <!-- ИНТЕГРАЦИЯ -->
                    <TextBlock Text="Интеграция с Windows"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <CheckBox x:Name="ChkShellIntegration"
                              Content="Пункт «Открыть в Silent Lens» в контекстном меню"
                              Checked="ChkShellIntegration_Changed"
                              Unchecked="ChkShellIntegration_Changed"
                              Margin="0,0,0,16"/>

                    <!-- О ПРОГРАММЕ -->
                    <TextBlock Text="О программе"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAccent}"
                               Margin="0,10,0,10"/>

                    <TextBlock Text="Silent Lens v1.0.0" Margin="0,0,0,4"/>
                    <TextBlock Text="Локальное приложение для управления метаданными фото."
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="© 2026 Boleznen"
                               Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource BaseButton}"
                            MinWidth="100"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>
                    <Button Content="Сохранить"
                            Style="{StaticResource AccentButton}"
                            MinWidth="120"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>